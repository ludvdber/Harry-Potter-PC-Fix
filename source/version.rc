#pragma code_page(65001)
#include <winres.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ACCIO_VERSION_NUM
 PRODUCTVERSION ACCIO_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Accio Launcher"
            VALUE "FileDescription",  "PC fix for Harry Potter: Goblet of Fire, Order of the Phoenix, Half-Blood Prince"
            VALUE "FileVersion",      ACCIO_VERSION_STR
            VALUE "InternalName",     "accio_hp_fix"
            VALUE "LegalCopyright",   "© 2026 Accio Launcher. PolyForm Strict 1.0.0, no redistribution."
            VALUE "OriginalFilename", "d3d9.dll"
            VALUE "ProductName",      "Harry Potter PC Fix"
            VALUE "ProductVersion",   ACCIO_VERSION_STR
            VALUE "Comments",         "https://acciolauncher.be/"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
